     }
 
+    /**
+     * LGUI: when opened by `lgui editor` (127.0.0.1, ?agent=1), always re-import the project's ui/ folder,
+     * so the editor never shows a stale browser copy after an Agent changed ui/. The bound folder (if any)
+     * is kept, so saving still writes back to ui/.
+     */
+    reloadFromLguiProject(): Promise<boolean> {
+        if (!this.active) return Promise.resolve(false);
+        const workspaceId = this.registry.activeId;
+        return this.track(this.session.runExclusive(async () => {
+            let body: { name: string; files: { path: string; data: string }[] };
+            try {
+                const response = await fetch("/__lgui_editor/project", { cache: "no-store" });
+                if (!response.ok) throw new Error(`HTTP ${response.status}`);
+                body = await response.json();
+            } catch (error) {
+                this.chrome.setStatus(`LGUI: reading ui/ failed: ${error instanceof Error ? error.message : String(error)}`, "error");
+                return false;
+            }
+            const files = body.files.map((file) => ({
+                path: file.path,
+                data: Uint8Array.from(atob(file.data), (c) => c.charCodeAt(0)),
+            }));
+            const picked = await this.session.workspaceLifecycle.importFromLguiProject(body.name, files);
+            return this.importWorkspaceNow(picked, "ui/", workspaceId);
+        }));
+    }
+
     pickDirectoryProject(): Promise<BrowserProjectImportResult> {
