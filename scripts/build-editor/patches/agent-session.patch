diff --git a/src/editor/services/BrowserAgentSession.ts b/src/editor/services/BrowserAgentSession.ts
new file mode 100644
index 0000000..3c4a1a0
--- /dev/null
+++ b/src/editor/services/BrowserAgentSession.ts
@@ -0,0 +1,132 @@
+import type { EditorProjectSession } from "../modules/ProjectSessionModule";
+import type { EditorDisplayNodeSelector, SetDisplayNodePropsCommand } from "../model/EditorCommand";
+import { createDisplayNodeSaveTarget } from "./BrowserSaveTargetVerifier";
+import { createSetDisplayNodePropsOperation } from "../commands/DisplayNodePropsLogic";
+
+type AgentRequest = {
+    method: string;
+    requestId?: string;
+    identity?: { sessionId: string; generation: number; revision: number };
+    selector?: EditorDisplayNodeSelector;
+    operations?: SetDisplayNodePropsCommand[];
+    summary?: string;
+};
+type AgentResult = { ok: boolean; data?: any; error?: { code: string; message: string }; replayed?: boolean };
+const MUTATIONS = new Set(["transact", "undo", "redo", "save"]);
+const copy = <T>(value: T): T => structuredClone(value);
+const failure = (code: string, message: string): AgentResult => ({ ok: false, error: { code, message } });
+
+export class BrowserAgentSession {
+    private readonly completed = new Map<string, { signature: string; result: Promise<AgentResult> }>();
+    constructor(private readonly session: EditorProjectSession) {}
+
+    async request(input: unknown): Promise<AgentResult> {
+        if (!input || typeof input !== "object" || Array.isArray(input)) return failure("invalid_request", "Expected an RPC object.");
+        const request = copy(input) as AgentRequest;
+        if (typeof request.method !== "string") return failure("invalid_request", "method is required.");
+        const mutate = MUTATIONS.has(request.method);
+        if (mutate && (!request.requestId || typeof request.requestId !== "string" || request.requestId.length > 128)) {
+            return failure("request_id_required", "Mutations require a unique requestId, retained for exact retries.");
+        }
+        const signature = JSON.stringify(request);
+        if (mutate) {
+            const previous = this.completed.get(request.requestId!);
+            if (previous) {
+                if (previous.signature !== signature) return failure("request_id_conflict", "requestId was already used with a different payload.");
+                return { ...copy(await previous.result), replayed: true };
+            }
+            // Never evict an ID and silently make an old retry executable again.
+            if (this.completed.size >= 512) return failure("request_cache_full", "This verification session has reached 512 mutations; save and reopen before continuing.");
+        }
+        const result = this.session.runExclusive(async () => {
+            try { return copy(await this.execute(request)); }
+            catch (error) { return failure("agent_request_failed", error instanceof Error ? error.message : String(error)); }
+        }).catch(error => failure("session_disposed", String(error)));
+        if (mutate) this.completed.set(request.requestId!, { signature, result });
+        return copy(await result);
+    }
+
+    private state() {
+        return {
+            identity: this.session.liveSessionBridge.captureSessionIdentity(),
+            editor: this.session.commandAdapter.getSessionState(),
+            backend: this.session.liveSessionBridge.getState(),
+            workspace: { name: this.session.projectStorage.getWorkspaceName(), fairyPath: this.session.projectStorage.getFairyPath() },
+        };
+    }
+
+    private guard(request: AgentRequest, required: boolean): AgentResult | null {
+        const current = this.session.liveSessionBridge.captureSessionIdentity();
+        if (!current || !this.session.commandAdapter.isLiveSessionAligned()) return failure("live_session_unavailable", "The editor is not connected to an aligned live session.");
+        const expected = request.identity;
+        if (!expected) return required ? failure("identity_required", "Supply the identity returned by state/query.") : null;
+        if (expected.sessionId !== current.sessionId || expected.generation !== current.generation) return failure("session_mismatch", "The browser session was reopened or switched; query its new identity.");
+        if (expected.revision !== current.revision) return failure("stale_write", `Expected revision ${expected.revision}; actual ${current.revision}.`);
+        return null;
+    }
+
+    private entity(selector?: EditorDisplayNodeSelector): any {
+        const project = this.session.liveSessionBridge.getWorkingProject() as any;
+        if (!selector) return project;
+        const pkg = project?.packages?.find((p: any) => p.id === selector.packageId);
+        const resource = pkg?.resources?.find((r: any) => r.id === selector.componentResourceId);
+        return selector.displayNodeId ? resource?.component?.displayList?.find((n: any) => n.id === selector.displayNodeId) : resource;
+    }
+
+    private async execute(request: AgentRequest): Promise<AgentResult> {
+        const guard = this.guard(request, MUTATIONS.has(request.method) || request.method === "preflight" || request.method === "export");
+        if (guard) return guard;
+        if (request.method === "state") return { ok: true, data: this.state() };
+        if (request.method === "query") {
+            const entity = this.entity(request.selector);
+            return entity ? { ok: true, data: { ...this.state(), entity } } : failure("selector_not_found", "The requested stable ID does not exist in this session.");
+        }
+        if (request.method === "preflight" || request.method === "transact") {
+            const operations = request.operations;
+            if (!Array.isArray(operations) || operations.length === 0 || operations.length > 50) return failure("invalid_operations", "Supply 1–50 setDisplayNodeProps operations.");
+            for (const op of operations) {
+                if (!op || op.kind !== "setDisplayNodeProps" || !op.selector || !op.props || typeof op.props !== "object") return failure("unsupported_operation", "This bridge supports only structured setDisplayNodeProps transactions.");
+                if (!this.entity(op.selector)) return failure("selector_not_found", "A transaction target does not exist; nothing was changed.");
+            }
+            const preflight = await this.session.liveSessionBridge.preflightTransaction(
+                operations.map((command, index) => createSetDisplayNodePropsOperation(command, `agent-preflight-${index}`)),
+                request.identity!.revision,
+            );
+            if (!preflight.ok) return failure(preflight.error?.code || "preflight_failed", preflight.error?.message || "Preflight rejected the operation.");
+            if (request.method === "preflight") return { ok: true, data: { ...this.state(), preflight } };
+            const result = await this.session.applyDisplayNodePropsNow(operations, request.summary || "Agent transaction");
+            return result.result.ok
+                ? { ok: true, data: { ...this.state(), result: result.result } }
+                : failure(result.result.error?.code || "transaction_failed", result.result.error?.message || "Transaction rejected.");
+        }
+        if (request.method === "undo" || request.method === "redo") {
+            const result = request.method === "undo" ? await this.session.undoNow() : await this.session.redoNow();
+            return result.result.ok
+                ? { ok: true, data: { ...this.state(), result: result.result } }
+                : failure(result.result.error?.code || "history_failed", result.result.error?.message || "History action rejected.");
+        }
+        if (request.method === "save") {
+            if (request.selector && !this.entity(request.selector)) return failure("selector_not_found", "The explicit save verification target does not exist.");
+            const operations = this.session.lastResult?.operations || (this.session.lastResult?.operation ? [this.session.lastResult.operation] : []);
+            const selector = request.selector || operations.find(op => op.kind === "setDisplayNodeProps")?.selector;
+            const target = selector
+                ? createDisplayNodeSaveTarget(this.session.liveSessionBridge.getWorkingProject(), selector as EditorDisplayNodeSelector)
+                : this.session.liveSessionBridge.getLastSaveTarget();
+            if (!target) return failure("save_target_required", "Provide a stable display-node selector for persisted readback verification.");
+            const saved = await this.session.saveWorkspaceNow(target);
+            if (saved.kind === "unaligned") return failure("save_unaligned", "The editor and backend revisions are not aligned.");
+            const verified = saved.checkpointSaved && saved.result.ok && saved.result.results.reload.status === "verified";
+            return { ok: verified, ...(!verified ? { error: { code: "save_not_verified", message: "Check the save/readback/writeback outcome; skipped verification is not success." } } : {}), data: { ...this.state(), checkpointSaved: saved.checkpointSaved, browserWorkspaceSaved: saved.browserWorkspaceSaved, verification: saved.result.results.reload, save: saved.result.results.save, writeback: saved.result.writeback } };
+        }
+        if (request.method === "export") {
+            if (this.session.commandAdapter.getSessionState().dirty) return failure("unsaved_changes", "Save this shared session before exporting its persisted workspace.");
+            const archive = await this.session.projectStorage.exportWorkspaceZip();
+            if (!archive.blob) return failure("export_failed", "Workspace export returned no bytes.");
+            const bytes = new Uint8Array(await archive.blob.arrayBuffer());
+            let binary = "";
+            for (let start = 0; start < bytes.length; start += 32768) binary += String.fromCharCode(...bytes.subarray(start, start + 32768));
+            return { ok: true, data: { ...this.state(), fileName: archive.fileName, fileCount: archive.fileCount, bytes: archive.bytes, base64: btoa(binary) } };
+        }
+        return failure("unknown_method", `Unknown agent method: ${request.method}`);
+    }
+}
diff --git a/src/editor/services/BrowserAgentTransport.ts b/src/editor/services/BrowserAgentTransport.ts
new file mode 100644
index 0000000..0cebdea
--- /dev/null
+++ b/src/editor/services/BrowserAgentTransport.ts
@@ -0,0 +1,40 @@
+import type { EditorProjectSession } from "../modules/ProjectSessionModule";
+import { BrowserAgentSession } from "./BrowserAgentSession";
+
+declare global {
+    interface Window {
+        fairyEditorAgent?: { schemaVersion: 1; clientId: string; request(input: unknown): Promise<unknown> };
+    }
+}
+
+// LGUI: the relay is served by `lgui editor` on the same origin (127.0.0.1 only).
+// Requests arrive over Server-Sent Events; results go back with same-origin POSTs.
+const RELAY = "/__lgui_editor";
+
+/** Explicit local opt-in (`?agent=1` on 127.0.0.1); no public or filesystem backend. */
+export function installBrowserAgentTransport(session: EditorProjectSession): () => void {
+    if (location.hostname !== "127.0.0.1" || new URL(location.href).searchParams.get("agent") !== "1") return () => {};
+    const api = new BrowserAgentSession(session);
+    const clientId = crypto.randomUUID();
+    const endpoint = { schemaVersion: 1 as const, clientId, request: (input: unknown) => api.request(input) };
+    window.fairyEditorAgent = endpoint;
+    // keepalive (body limit 64 KiB) only for the final "bye"; results can be large.
+    const post = (route: string, body: unknown, keepalive = false) => fetch(`${RELAY}/${route}`, {
+        method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(body), keepalive,
+    }).catch(() => undefined);
+    const announce = () => post("hello", { clientId, url: location.href, schemaVersion: 1 });
+    const events = new EventSource(`${RELAY}/events?clientId=${encodeURIComponent(clientId)}`);
+    events.addEventListener("request", async (event) => {
+        const payload = JSON.parse((event as MessageEvent<string>).data) as { id: string; request: unknown };
+        const result = await api.request(payload.request);
+        await post("response", { clientId, id: payload.id, result });
+    });
+    events.addEventListener("open", announce);
+    const timer = window.setInterval(announce, 2000);
+    return () => {
+        window.clearInterval(timer);
+        events.close();
+        void post("bye", { clientId }, true);
+        if (window.fairyEditorAgent === endpoint) delete window.fairyEditorAgent;
+    };
+}
