# 默认按原样保存字节（图片、界面包、随插件带的工具都不改换行）。
# 只对我们自己写的文本文件统一成 LF。
* -text
*.md text eol=lf
*.ts text eol=lf
*.cs text eol=lf
*.ps1 text eol=lf
*.mjs text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
LICENSE text eol=lf

# 随插件带的工具按原样保存，不改换行。
plugin/tools/vendor/node_modules/** -text

# 固定上游 Unity 源码和 .meta 保留原始字节，便于核对来源。
plugin/framework/backends/unity/package/FairyGUI/** -text -whitespace
