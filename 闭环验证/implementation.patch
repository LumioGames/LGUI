@@ -0,0 +1,33 @@
+/// <reference types="vite/client" />
+import type { EditorProjectSession } from "../modules/ProjectSessionModule";
+import { BrowserAgentSession } from "./BrowserAgentSession";
+
+declare global {
+    interface Window {
+        fairyEditorAgent?: { schemaVersion: 1; clientId: string; request(input: unknown): Promise<unknown> };
+    }
+}
+
+/** Explicit local development opt-in; no public production or filesystem backend. */
+export function installBrowserAgentTransport(session: EditorProjectSession, hot: ImportMeta["hot"]): () => void {
+    if (!hot || location.hostname !== "127.0.0.1"
+        || new URL(location.href).searchParams.get("agent") !== "1") return () => {};
+    const api = new BrowserAgentSession(session);
+    const clientId = crypto.randomUUID();
+    const endpoint = { schemaVersion: 1 as const, clientId, request: (input: unknown) => api.request(input) };
+    window.fairyEditorAgent = endpoint;
+    const announce = () => hot.send("fairy-agent:hello", { clientId, url: location.href, schemaVersion: 1 });
+    const onRequest = async (payload: { id: string; request: unknown }) => {
+        const result = await api.request(payload.request);
+        hot.send("fairy-agent:response", { id: payload.id, result });
+    };
+    hot.on("fairy-agent:request", onRequest);
+    announce();
+    const timer = window.setInterval(announce, 2000);
+    return () => {
+        window.clearInterval(timer);
+        hot.off("fairy-agent:request", onRequest);
+        hot.send("fairy-agent:bye", { clientId });
+        if (window.fairyEditorAgent === endpoint) delete window.fairyEditorAgent;
+    };
+}
