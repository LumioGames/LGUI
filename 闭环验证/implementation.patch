diff --git a/scripts/agent-relay.mjs b/scripts/agent-relay.mjs
new file mode 100644
--- /dev/null
+++ b/scripts/agent-relay.mjs
@@ -0,0 +1,71 @@
+import crypto from 'node:crypto';
+import fs from 'node:fs';
+import path from 'node:path';
+
+/** Vite development transport. Only enabled by an explicit local connection-file path. */
+export default function agentRelay(options = {}) {
+  return {
+    name: 'fairygui-local-agent-session', apply: 'serve',
+    configureServer(server) {
+      const file = options.connectionFile || process.env.FAIRY_AGENT_CONNECTION;
+      if (!file) return;
+      if (server.config.server.host !== '127.0.0.1') throw new Error('Agent relay requires host 127.0.0.1, matching its published origin.');
+      const connectionPath = path.resolve(file);
+      const token = crypto.randomBytes(32).toString('hex');
+      const clients = new Map(), pending = new Map();
+      let baseUrl = '';
+      const finish = (id, value, status = 200) => {
+        const item = pending.get(id); if (!item) return;
+        clearTimeout(item.timer); pending.delete(id);
+        if (!item.res.writableEnded) { item.res.writeHead(status, { 'Content-Type': 'application/json', 'Cache-Control': 'no-store' }); item.res.end(JSON.stringify(value)); }
+      };
+      server.ws.on('fairy-agent:hello', (data, client) => {
+        if (typeof data?.clientId !== 'string' || data.clientId.length > 128) return;
+        const url = String(data.url || '');
+        if (!url.startsWith(baseUrl + '/')) return;
+        clients.set(data.clientId, { client, clientId: data.clientId, url, lastSeen: Date.now() });
+      });
+      server.ws.on('fairy-agent:bye', (data, client) => {
+        if (clients.get(data?.clientId)?.client === client) clients.delete(data.clientId);
+      });
+      server.ws.on('fairy-agent:response', (data, client) => {
+        const item = pending.get(data?.id);
+        if (item?.client === client) finish(data.id, data.result);
+      });
+      server.httpServer.once('listening', () => {
+        const address = server.httpServer.address();
+        baseUrl = `http://127.0.0.1:${address.port}`;
+        fs.mkdirSync(path.dirname(connectionPath), { recursive: true });
+        fs.writeFileSync(connectionPath, JSON.stringify({ schemaVersion: 1, baseUrl, token, pid: process.pid, startedAt: new Date().toISOString() }, null, 2), { mode: 0o600 });
+        server.config.logger.info(`Local Agent connection: ${connectionPath}`);
+      });
+      server.middlewares.use(async (req, res, next) => {
+        const route = req.url?.split('?')[0];
+        if (!route?.startsWith('/__fairy_agent/')) return next();
+        const reply = (status, code, message) => { res.writeHead(status, { 'Content-Type': 'application/json', 'Cache-Control': 'no-store' }); res.end(JSON.stringify({ ok: false, error: { code, message } })); };
+        if (req.headers.authorization !== `Bearer ${token}`) return reply(401, 'unauthorized', 'Local connection token required.');
+        if (req.headers.origin && req.headers.origin !== baseUrl) return reply(403, 'origin_rejected', 'Cross-origin Agent calls are disabled.');
+        if (route === '/__fairy_agent/clients' && req.method === 'GET') {
+          const active = [...clients.values()].filter(x => Date.now() - x.lastSeen < 10000).map(({ clientId, url }) => ({ clientId, url }));
+          res.writeHead(200, { 'Content-Type': 'application/json', 'Cache-Control': 'no-store' }); res.end(JSON.stringify({ ok: true, data: { clients: active } })); return;
+        }
+        if (route !== '/__fairy_agent/rpc' || req.method !== 'POST') return reply(404, 'unknown_route', 'Use POST rpc or GET clients.');
+        try {
+          let raw = '';
+          for await (const chunk of req) { raw += chunk.toString(); if (Buffer.byteLength(raw) > 256 * 1024) return reply(413, 'request_too_large', 'Maximum request size is 256 KiB.'); }
+          const body = JSON.parse(raw);
+          const target = clients.get(body.clientId);
+          if (!target || Date.now() - target.lastSeen >= 10000) return reply(409, 'client_unavailable', 'Select an active browser clientId; writes are never broadcast.');
+          if (!body.request || typeof body.request !== 'object') return reply(400, 'invalid_request', 'request object required.');
+          const id = crypto.randomUUID();
+          const timer = setTimeout(() => finish(id, { ok: false, error: { code: 'result_unknown', message: 'Browser response timed out. A write may have executed: retry the exact same requestId and payload; never invent a new ID for an uncertain write.' } }, 504), options.timeoutMs || 15000);
+          pending.set(id, { res, timer, client: target.client });
+          target.client.send('fairy-agent:request', { id, request: body.request });
+        } catch (error) { if (!res.writableEnded) reply(400, 'invalid_request', String(error)); }
+      });
+      server.httpServer.once('close', () => {
+        for (const id of pending.keys()) finish(id, { ok: false, error: { code: 'result_unknown', message: 'Local relay stopped before delivery was confirmed.' } }, 503);
+      });
+    },
+  };
+}
diff --git a/scripts/internal/verify-agent-relay.test.mjs b/scripts/internal/verify-agent-relay.test.mjs
new file mode 100644
--- /dev/null
+++ b/scripts/internal/verify-agent-relay.test.mjs
@@ -0,0 +1,46 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import http from 'node:http';
+import fs from 'node:fs';
+import path from 'node:path';
+import relay from '../agent-relay.mjs';
+
+test('relay binds only the documented 127.0.0.1 origin', () => {
+  const dummy = { config: { server: { host: 'localhost' } }, ws: { on() {} }, httpServer: { once() {} }, middlewares: { use() {} } };
+  assert.throws(() => relay({ connectionFile: 'unused' }).configureServer(dummy), /127\.0\.0\.1/);
+});
+test('real loopback relay authenticates, targets one client and reports uncertain timeout', async () => {
+  const folder = fs.mkdtempSync(path.resolve('../../闭环验证/evidence/relay-test-'));
+  const connectionFile = path.join(folder, 'connection.local.json');
+  const events = new Map(); let middleware;
+  const server = http.createServer((req, res) => middleware(req, res, () => { res.writeHead(404).end(); }));
+  relay({ connectionFile, timeoutMs: 35 }).configureServer({
+    config: { server: { host: '127.0.0.1' }, logger: { info() {} } },
+    ws: { on: (name, fn) => events.set(name, fn) }, httpServer: server,
+    middlewares: { use: fn => { middleware = fn; } },
+  });
+  await new Promise(resolve => server.listen(0, '127.0.0.1', resolve));
+  const connection = JSON.parse(fs.readFileSync(connectionFile));
+  const headers = { Authorization: `Bearer ${connection.token}`, 'Content-Type': 'application/json' };
+  const calls = [];
+  const client = name => ({ send(_event, payload) {
+    calls.push(name);
+    if (payload.request.method !== 'wait') events.get('fairy-agent:response')({ id: payload.id, result: { ok: true, data: { client: name } } }, this);
+  } });
+  const first = client('first'), second = client('second');
+  events.get('fairy-agent:hello')({ clientId: 'a', url: connection.baseUrl + '/?agent=1' }, first);
+  events.get('fairy-agent:hello')({ clientId: 'b', url: connection.baseUrl + '/?agent=1' }, second);
+  const rpc = body => fetch(connection.baseUrl + '/__fairy_agent/rpc', { method: 'POST', headers, body: JSON.stringify(body) });
+  try {
+    assert.equal((await fetch(connection.baseUrl + '/__fairy_agent/clients')).status, 401);
+    assert.equal((await fetch(connection.baseUrl + '/__fairy_agent/clients', { headers: { ...headers, Origin: 'https://example.invalid' } })).status, 403);
+    assert.equal((await rpc({ clientId: 'missing', request: { method: 'state' } })).status, 409);
+    const result = await (await rpc({ clientId: 'b', request: { method: 'state' } })).json();
+    assert.equal(result.data.client, 'second'); assert.deepEqual(calls, ['second']);
+    const timeout = await rpc({ clientId: 'a', request: { method: 'wait' } });
+    assert.equal(timeout.status, 504); assert.equal((await timeout.json()).error.code, 'result_unknown');
+  } finally {
+    await new Promise(resolve => server.close(resolve));
+    fs.unlinkSync(connectionFile);
+  }
+});
diff --git a/scripts/internal/verify-agent-session.mjs b/scripts/internal/verify-agent-session.mjs
new file mode 100644
--- /dev/null
+++ b/scripts/internal/verify-agent-session.mjs
@@ -0,0 +1,55 @@
+import assert from 'node:assert/strict';
+import { importTypeScriptModule } from '../import-typescript-module.mjs';
+const { BrowserAgentSession } = await importTypeScriptModule('src/editor/services/BrowserAgentSession.ts');
+const identity = { sessionId: 'session-A', generation: 1, revision: 0 };
+let project = { packages: [{ id: 'p', resources: [{ id: 'c', component: { displayList: [{ id: 'n', text: 'original' }] } }] }] };
+let state = { revision: 0, dirty: false, liveSession: true };
+let tail = Promise.resolve(); let calls = 0;
+const session = {
+  snapshot: {},
+  commandAdapter: { getSessionState: () => ({ ...state }), isLiveSessionAligned: () => true },
+  liveSessionBridge: {
+    captureSessionIdentity: () => ({ ...identity }), getState: () => ({ status: 'connected', ...identity, dirty: state.dirty }),
+    getWorkingProject: () => structuredClone(project), getLastSaveTarget: () => null,
+    preflightTransaction: async () => ({ ok: true, revision: identity.revision }),
+  },
+  projectStorage: { getWorkspaceName: () => 'Inventory', getFairyPath: () => 'Inventory.fairy' },
+  runExclusive(task) { const result = tail.then(task); tail = result.catch(() => {}); return result; },
+  async applyDisplayNodePropsNow(commands) {
+    calls++; await new Promise(resolve => setTimeout(resolve, 5));
+    project.packages[0].resources[0].component.displayList[0].text = commands[0].props.text;
+    identity.revision++; state = { revision: identity.revision, dirty: true, liveSession: true };
+    return { result: { ok: true, revision: identity.revision } };
+  },
+};
+const api = new BrowserAgentSession(session);
+const selector = { packageId: 'p', componentResourceId: 'c', displayNodeId: 'n' };
+const input = { method: 'transact', requestId: 'write-1', identity: { ...identity }, operations: [{ kind: 'setDisplayNodeProps', selector, props: { text: 'updated' } }] };
+const before = await api.request({ method: 'state' });
+assert.equal(before.ok, true, 'state must expose the connected shared session');
+const query = await api.request({ method: 'query', selector });
+query.data.entity.text = 'external mutation';
+assert.equal(project.packages[0].resources[0].component.displayList[0].text, 'original', 'query must return detached data');
+const results = await Promise.all([api.request(input), api.request(input)]);
+assert.equal(results[0].ok, true); assert.equal(results[1].ok, true); assert.equal(calls, 1, 'same request ID must execute once');
+const replay = await api.request(input); assert.equal(replay.ok, true); assert.equal(calls, 1);
+const reused = await api.request({ ...input, operations: [{ ...input.operations[0], props: { text: 'wrong' } }] });
+assert.equal(reused.error.code, 'request_id_conflict');
+const stale = await api.request({ ...input, requestId: 'write-stale' });
+assert.equal(stale.error.code, 'stale_write'); assert.equal(calls, 1);
+const wrongSession = await api.request({ ...input, requestId: 'wrong-session', identity: { ...identity, sessionId: 'old-session' } });
+assert.equal(wrongSession.error.code, 'session_mismatch');
+const missing = await api.request({ method: 'query', selector: { ...selector, displayNodeId: 'missing' } });
+assert.equal(missing.error.code, 'selector_not_found');
+const concurrentIdentity = { ...identity };
+const next = id => ({ ...input, requestId: id, identity: concurrentIdentity });
+const concurrent = await Promise.all([api.request(next('concurrent-1')), api.request(next('concurrent-2'))]);
+assert.equal(concurrent.filter(x => x.ok).length, 1, 'revision must be checked inside the shared queue');
+assert.equal(concurrent.find(x => !x.ok).error.code, 'stale_write');
+session.saveWorkspaceNow = async () => ({ kind: 'result', checkpointSaved: true, browserWorkspaceSaved: true,
+  result: { ok: true, results: { reload: { ok: true, status: 'skipped' }, save: { ok: true } } } });
+const missingSave = await api.request({ method: 'save', requestId: 'missing-save', identity: { ...identity }, selector: { ...selector, displayNodeId: 'missing' } });
+assert.equal(missingSave.error?.code, 'selector_not_found', 'missing save target must fail before save');
+const skippedSave = await api.request({ method: 'save', requestId: 'skipped-save', identity: { ...identity }, selector });
+assert.equal(skippedSave.ok, false, 'skipped readback must not be reported as verified save');
+console.log(JSON.stringify({ passed: true, cases: ['shared state', 'detached query', 'inflight dedupe', 'completed replay', 'payload conflict', 'stale write', 'session mismatch', 'missing target', 'serialized competing writes'], calls }));
diff --git a/src/editor/services/BrowserAgentSession.ts b/src/editor/services/BrowserAgentSession.ts
new file mode 100644
--- /dev/null
+++ b/src/editor/services/BrowserAgentSession.ts
@@ -0,0 +1,132 @@
+import type { EditorProjectSession } from "../modules/ProjectSessionModule";
+import type { EditorDisplayNodeSelector, SetDisplayNodePropsCommand } from "../model/EditorCommand";
+import { createDisplayNodeSaveTarget } from "./BrowserSaveTargetVerifier";
+import { createSetDisplayNodePropsOperation } from "../commands/DisplayNodePropsLogic";
+
+type AgentRequest = {
+    method: string;
+    requestId?: string;
+    identity?: { sessionId: string; generation: number; revision: number };
+    selector?: EditorDisplayNodeSelector;
+    operations?: SetDisplayNodePropsCommand[];
+    summary?: string;
+};
+type AgentResult = { ok: boolean; data?: any; error?: { code: string; message: string }; replayed?: boolean };
+const MUTATIONS = new Set(["transact", "undo", "redo", "save"]);
+const copy = <T>(value: T): T => structuredClone(value);
+const failure = (code: string, message: string): AgentResult => ({ ok: false, error: { code, message } });
+
+export class BrowserAgentSession {
+    private readonly completed = new Map<string, { signature: string; result: Promise<AgentResult> }>();
+    constructor(private readonly session: EditorProjectSession) {}
+
+    async request(input: unknown): Promise<AgentResult> {
+        if (!input || typeof input !== "object" || Array.isArray(input)) return failure("invalid_request", "Expected an RPC object.");
+        const request = copy(input) as AgentRequest;
+        if (typeof request.method !== "string") return failure("invalid_request", "method is required.");
+        const mutate = MUTATIONS.has(request.method);
+        if (mutate && (!request.requestId || typeof request.requestId !== "string" || request.requestId.length > 128)) {
+            return failure("request_id_required", "Mutations require a unique requestId, retained for exact retries.");
+        }
+        const signature = JSON.stringify(request);
+        if (mutate) {
+            const previous = this.completed.get(request.requestId!);
+            if (previous) {
+                if (previous.signature !== signature) return failure("request_id_conflict", "requestId was already used with a different payload.");
+                return { ...copy(await previous.result), replayed: true };
+            }
+            // Never evict an ID and silently make an old retry executable again.
+            if (this.completed.size >= 512) return failure("request_cache_full", "This verification session has reached 512 mutations; save and reopen before continuing.");
+        }
+        const result = this.session.runExclusive(async () => {
+            try { return copy(await this.execute(request)); }
+            catch (error) { return failure("agent_request_failed", error instanceof Error ? error.message : String(error)); }
+        }).catch(error => failure("session_disposed", String(error)));
+        if (mutate) this.completed.set(request.requestId!, { signature, result });
+        return copy(await result);
+    }
+
+    private state() {
+        return {
+            identity: this.session.liveSessionBridge.captureSessionIdentity(),
+            editor: this.session.commandAdapter.getSessionState(),
+            backend: this.session.liveSessionBridge.getState(),
+            workspace: { name: this.session.projectStorage.getWorkspaceName(), fairyPath: this.session.projectStorage.getFairyPath() },
+        };
+    }
+
+    private guard(request: AgentRequest, required: boolean): AgentResult | null {
+        const current = this.session.liveSessionBridge.captureSessionIdentity();
+        if (!current || !this.session.commandAdapter.isLiveSessionAligned()) return failure("live_session_unavailable", "The editor is not connected to an aligned live session.");
+        const expected = request.identity;
+        if (!expected) return required ? failure("identity_required", "Supply the identity returned by state/query.") : null;
+        if (expected.sessionId !== current.sessionId || expected.generation !== current.generation) return failure("session_mismatch", "The browser session was reopened or switched; query its new identity.");
+        if (expected.revision !== current.revision) return failure("stale_write", `Expected revision ${expected.revision}; actual ${current.revision}.`);
+        return null;
+    }
+
+    private entity(selector?: EditorDisplayNodeSelector): any {
+        const project = this.session.liveSessionBridge.getWorkingProject() as any;
+        if (!selector) return project;
+        const pkg = project?.packages?.find((p: any) => p.id === selector.packageId);
+        const resource = pkg?.resources?.find((r: any) => r.id === selector.componentResourceId);
+        return selector.displayNodeId ? resource?.component?.displayList?.find((n: any) => n.id === selector.displayNodeId) : resource;
+    }
+
+    private async execute(request: AgentRequest): Promise<AgentResult> {
+        const guard = this.guard(request, MUTATIONS.has(request.method) || request.method === "preflight" || request.method === "export");
+        if (guard) return guard;
+        if (request.method === "state") return { ok: true, data: this.state() };
+        if (request.method === "query") {
+            const entity = this.entity(request.selector);
+            return entity ? { ok: true, data: { ...this.state(), entity } } : failure("selector_not_found", "The requested stable ID does not exist in this session.");
+        }
+        if (request.method === "preflight" || request.method === "transact") {
+            const operations = request.operations;
+            if (!Array.isArray(operations) || operations.length === 0 || operations.length > 50) return failure("invalid_operations", "Supply 1–50 setDisplayNodeProps operations.");
+            for (const op of operations) {
+                if (!op || op.kind !== "setDisplayNodeProps" || !op.selector || !op.props || typeof op.props !== "object") return failure("unsupported_operation", "This bridge supports only structured setDisplayNodeProps transactions.");
+                if (!this.entity(op.selector)) return failure("selector_not_found", "A transaction target does not exist; nothing was changed.");
+            }
+            const preflight = await this.session.liveSessionBridge.preflightTransaction(
+                operations.map((command, index) => createSetDisplayNodePropsOperation(command, `agent-preflight-${index}`)),
+                request.identity!.revision,
+            );
+            if (!preflight.ok) return failure(preflight.error?.code || "preflight_failed", preflight.error?.message || "Preflight rejected the operation.");
+            if (request.method === "preflight") return { ok: true, data: { ...this.state(), preflight } };
+            const result = await this.session.applyDisplayNodePropsNow(operations, request.summary || "Agent transaction");
+            return result.result.ok
+                ? { ok: true, data: { ...this.state(), result: result.result } }
+                : failure(result.result.error?.code || "transaction_failed", result.result.error?.message || "Transaction rejected.");
+        }
+        if (request.method === "undo" || request.method === "redo") {
+            const result = request.method === "undo" ? await this.session.undoNow() : await this.session.redoNow();
+            return result.result.ok
+                ? { ok: true, data: { ...this.state(), result: result.result } }
+                : failure(result.result.error?.code || "history_failed", result.result.error?.message || "History action rejected.");
+        }
+        if (request.method === "save") {
+            if (request.selector && !this.entity(request.selector)) return failure("selector_not_found", "The explicit save verification target does not exist.");
+            const operations = this.session.lastResult?.operations || (this.session.lastResult?.operation ? [this.session.lastResult.operation] : []);
+            const selector = request.selector || operations.find(op => op.kind === "setDisplayNodeProps")?.selector;
+            const target = selector
+                ? createDisplayNodeSaveTarget(this.session.liveSessionBridge.getWorkingProject(), selector as EditorDisplayNodeSelector)
+                : this.session.liveSessionBridge.getLastSaveTarget();
+            if (!target) return failure("save_target_required", "Provide a stable display-node selector for persisted readback verification.");
+            const saved = await this.session.saveWorkspaceNow(target);
+            if (saved.kind === "unaligned") return failure("save_unaligned", "The editor and backend revisions are not aligned.");
+            const verified = saved.checkpointSaved && saved.result.ok && saved.result.results.reload.status === "verified";
+            return { ok: verified, ...(!verified ? { error: { code: "save_not_verified", message: "Check the save/readback/writeback outcome; skipped verification is not success." } } : {}), data: { ...this.state(), checkpointSaved: saved.checkpointSaved, browserWorkspaceSaved: saved.browserWorkspaceSaved, verification: saved.result.results.reload, save: saved.result.results.save, writeback: saved.result.writeback } };
+        }
+        if (request.method === "export") {
+            if (this.session.commandAdapter.getSessionState().dirty) return failure("unsaved_changes", "Save this shared session before exporting its persisted workspace.");
+            const archive = await this.session.projectStorage.exportWorkspaceZip();
+            if (!archive.blob) return failure("export_failed", "Workspace export returned no bytes.");
+            const bytes = new Uint8Array(await archive.blob.arrayBuffer());
+            let binary = "";
+            for (let start = 0; start < bytes.length; start += 32768) binary += String.fromCharCode(...bytes.subarray(start, start + 32768));
+            return { ok: true, data: { ...this.state(), fileName: archive.fileName, fileCount: archive.fileCount, bytes: archive.bytes, base64: btoa(binary) } };
+        }
+        return failure("unknown_method", `Unknown agent method: ${request.method}`);
+    }
+}
