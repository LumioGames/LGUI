{
  "compilerOptions": {
    "strict": true,
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "lib": ["ES2020"],
    "types": [],
    "baseUrl": ".",
    "paths": {
      "lgui": [".lgui/framework/index.ts"],
      "lgui/ui": [".lgui/build/types/index.d.ts"]
    }
  },
  "include": ["src", "tests", ".lgui/framework/env.d.ts"]
}
